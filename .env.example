# Environment Variables
# Copy this file to .env and fill in your values

# Host Secrets (from template)
HOST_DATABASE_URL=
HOST_DATABASE_AUTH_TOKEN=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# API Secrets (from template)
API_DATABASE_URL=
API_DATABASE_AUTH_TOKEN=

# Zephyr Cloud (for deployment)
ZE_SERVER_TOKEN=
ZE_USER_EMAIL=

# NEAR (optional - for automated publishing)
# NEAR_PRIVATE_KEY=ed25519:...

# Registry relay (optional - for sponsored FastKV delegate submission)
# REGISTRY_RELAY_ACCOUNT_ID=dev.everything.near
# REGISTRY_RELAY_PRIVATE_KEY=ed25519:...
# REGISTRY_RELAY_NETWORK=mainnet

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Open Crosspost — @crosspost/sdk uses absolute paths (/auth/..., /api/post, …) with URL(base).
# Use an origin-only API base (default: same as the host or UI dev server). The host and UI dev
# server proxy those paths to OPEN_CROSSPOST_UPSTREAM_URL (default https://api.opencrosspost.com).
# Set PUBLIC_OPEN_CROSSPOST_API only for a full URL (e.g. https://api.opencrosspost.com) or a path prefix (SDK limitation: path prefixes are not supported).
# Default: https://api.opencrosspost.com — override if the public API is down or you use a local mirror:
# OPEN_CROSSPOST_UPSTREAM_URL=http://localhost:8080
OPEN_CROSSPOST_UPSTREAM_URL=
PUBLIC_OPEN_CROSSPOST_API=
# OPEN_CROSSPOST_PROXY_API=

# Twitter/X OAuth when running the @crosspost/twitter plugin locally (see plugins/twitter/plugin.dev.ts)
# TWITTER_CLIENT_ID=
# TWITTER_CLIENT_SECRET=
